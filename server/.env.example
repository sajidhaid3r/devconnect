# ---- Server environment variables ----
# Copy this file to ".env" in the /server folder and fill in real values.

# Local PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example if you set username "postgres" and password "postgres123" during install:
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/devconnect"

# Any long random string — used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# GitHub OAuth App credentials (create one at https://github.com/settings/developers)
# Authorization callback URL should be: http://localhost:5000/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Cloudinary (free tier) — from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# App config
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
